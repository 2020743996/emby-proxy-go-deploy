[Unit]
Description=Emby Reverse Proxy (Go)
Documentation=https://github.com/Gsy-allen/emby-reverse-proxy-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/emby-reverse-proxy-go
EnvironmentFile=/opt/emby-reverse-proxy-go/emby-proxy.env
ExecStart=/opt/emby-reverse-proxy-go/emby-proxy
Restart=always
RestartSec=3
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
