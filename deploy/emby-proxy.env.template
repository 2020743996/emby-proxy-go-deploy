# 由 install.sh 生成的 emby-reverse-proxy-go 配置文件
# 修改后需重启服务生效：emby 重启  或  systemctl restart emby-proxy

# 监听地址：默认仅监听本机回环，由 nginx 对外转发。
# 如需绕过 nginx 直连，可改为 0.0.0.0:__BACKEND_PORT__ 并放行防火墙/安全组
LISTEN_ADDR=127.0.0.1:__BACKEND_PORT__

# 是否禁止把 内网IP/localhost 作为反代目标（防 SSRF，更安全）
# 若你的上游 Emby 在内网，请改为 false 后重启
BLOCK_PRIVATE_TARGETS=true

# 出站代理：仅影响本程序访问上游 Emby 的连接（含 WebSocket），按需取消注释
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://user:pass@127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
